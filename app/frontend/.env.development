# Development only. Vite loads .env.development for `npm run dev`, never for
# `npm run build`, so this cannot leak into a production bundle.
#
# In development the SPA runs on :5173 and the API on :8000, so it needs an
# absolute base URL. The backend already allows localhost:5173 through CORS.
#
# There used to be a plain `.env` here setting VITE_API_BASE=/api. Because Vite
# loads `.env` for builds as well, every production bundle called /api/*, which
# the backend's SPA catch-all answered with index.html and a 200. Views then
# received HTML where they expected JSON.
VITE_API_BASE=http://127.0.0.1:8000
